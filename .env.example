# Copy this file to .env and fill in the values yourself. Never commit .env.

# Free key from https://etherscan.io/myapikey (works for Monad Testnet, chainid 10143)
ETHERSCAN_API_KEY=

# Throwaway TESTNET-ONLY wallet key, used only to deploy the contract. Never a real wallet.
DEPLOYER_PRIVATE_KEY=

# Public RPC (no key needed). Fallback: https://rpc.ankr.com/monad_testnet
MONAD_RPC_URL=https://rpc-testnet.monadinfra.com

# Filled in after the contract is deployed (public address, not secret)
REGISTRY_CONTRACT_ADDRESS=

# AI features (optional). Qwen is the default; Gemini works as a fallback. Use a key from a project
# WITHOUT billing so the free tier is a hard cap. Set AI_DISABLED=1 to switch the AI off at once.
QWEN_API_KEY=
GEMINI_API_KEY=
# Optional overrides: LLM_MODEL, LLM_BASE_URL, AI_DISABLED
